frr defaults traditional
hostname sjc-fabric
log syslog informational

interface lo
 ip address 10.255.255.3/32
 ipv6 address fc00:0:3::1/128
!
interface bond0
 description sjc-worker2-facing (site edge node) -- LACP bond of eth1 + eth2
 ip address 10.1.20.2/24
 ipv6 address 2001:db8:1:20::2/64
!

ipv6 route 2001:db8:ff02::/48 Null0
ipv6 route fc00:0:3::/48 Null0

# This node's egress shard's two masquerade addresses
# (GALACTIC_NAT_SHARD_PUB_ADDR6 and _ADDR4, resources/galactic-nat/sjc/
# node-patch.yaml), originated into the underlay so a reply from outside the
# fabric can reach the shard that sent the request (#549). galactic-nat
# advertises the IPv6 one as an EVPN Type 5 path, which the plain-IPv6-
# unicast transit never sees, and the IPv4 one is advertised by nothing at
# all -- so a reply from the off-fabric host (remote-host on tr4) hit the
# transit's own management default and was discarded. The shard's own node
# has to originate these, not this site's edge node, and each shard needs
# its own prefix rather than one aggregate covering all three sites: see
# resources/fabric-router/dfw/frr.conf.dfw-worker's fuller rationale, which
# also covers the prefix lengths and why Null0 here is safe.
ipv6 route 2001:db8:9966:3::/64 Null0
ip route 192.0.2.3/32 Null0

router bgp 65000
 bgp router-id 10.255.255.3
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 # One iBGP session, to this site's edge node, and nothing else. A compute
 # node is not transit-facing: it has no link to a transit router and no
 # eBGP session anywhere. Everything it learns about the rest of the fabric
 # arrives over this session (the edge node sets next-hop-self on it), and
 # everything it originates leaves the site the same way.
 neighbor 2001:db8:1:20::1 remote-as 65000
 neighbor 10.1.20.1 remote-as 65000

 address-family ipv6 unicast
  neighbor 2001:db8:1:20::1 activate
  # allowas-in: the transit reflects one AS 65000 site's prefixes to
  # another, so paths arriving back here legitimately carry this node's own
  # AS. Without it the loop check drops every remote site's locator.
  neighbor 2001:db8:1:20::1 allowas-in 1
  network 2001:db8:ff02::/48
  network fc00:0:3::/48
  # This node's shard's IPv6 masquerade address -- see this file's own
  # comment above.
  network 2001:db8:9966:3::/64
 exit-address-family

 # IPv4 underlay -- this node's own /32 loopback, plus the one /32 below
 # that is not a loopback: this node's shard's NAT64 masquerade address.
 # There is no IPv4 counterpart to the SRv6 locator block, because tenant
 # IPv4 (ns20/ns40) rides inside SRv6 and never touches the IPv4 transit
 # FIB -- a NAT64 reply is the exception, arriving from an IPv4-only
 # destination outside the fabric.
 address-family ipv4 unicast
  neighbor 10.1.20.1 activate
  neighbor 10.1.20.1 allowas-in 1
  network 10.255.255.3/32
  # This node's shard's IPv4 (NAT64) masquerade address. The one IPv4
  # prefix here that is not a loopback: a NAT64 reply arrives from an
  # IPv4-only destination, so unlike tenant IPv4 it does not ride inside
  # SRv6 and does need a route in the transit FIB.
  network 192.0.2.3/32
 exit-address-family

ip forwarding
ipv6 forwarding
