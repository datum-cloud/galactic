frr defaults traditional
hostname iad-fabric
log syslog informational

interface lo
 ip address 10.255.255.1/32
 ipv6 address fc00:0:4::1/128

interface eth1
 description tr3-facing
 ip address 10.1.30.2/24
 ipv6 address 2001:db8:1:30::2/64

ipv6 route 2001:db8:ff03::/48 Null0
ipv6 route fc00:0:4::/48 Null0

router bgp 65000
 bgp router-id 10.255.255.1
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 neighbor 2001:db8:1:30::1 remote-as 65100
 neighbor 10.1.30.1 remote-as 65100

 address-family ipv6 unicast
  neighbor 2001:db8:1:30::1 activate
  neighbor 2001:db8:1:30::1 allowas-in 1
  network 2001:db8:ff03::/48
  network fc00:0:4::/48
 exit-address-family

 # IPv4 underlay -- see frr.conf.dfw-worker for why it carries the /32
 # loopback and nothing else.
 address-family ipv4 unicast
  neighbor 10.1.30.1 activate
  neighbor 10.1.30.1 allowas-in 1
  network 10.255.255.1/32
 exit-address-family

ip forwarding
ipv6 forwarding
