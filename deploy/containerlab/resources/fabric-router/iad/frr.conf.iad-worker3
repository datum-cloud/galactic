frr defaults traditional
hostname iad-fabric-rr
log syslog informational

interface lo
 ip address 10.255.255.4/32
 # /128 provides the reachable address every galactic-router in the lab
 # opens its EVPN session to (fc00:0:8::1 port 1790). This node is the
 # single route reflector for all three clusters.
 ipv6 address fc00:0:8::1/128
!
interface eth1
 description iad-worker2-facing (site edge node)
 ip address 10.1.31.2/24
 ipv6 address 2001:db8:1:31::2/64
!

ipv6 route fc00:0:8::/48 Null0
!
route-map SET_SRC permit 10
 set src fc00:0:8::1
!

router bgp 65000
 bgp router-id 10.255.255.4
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 # One iBGP session, to iad's edge node, and nothing else -- the route
 # reflector is not transit-facing either. This carries only underlay
 # reachability; the EVPN sessions this node reflects for are galactic-router's
 # own, on port 1790, and ride on top of the loopback reachability this
 # session provides (resources/galactic-control/iad/).
 neighbor 2001:db8:1:31::1 remote-as 65000
 neighbor 10.1.31.1 remote-as 65000

 address-family ipv6 unicast
  neighbor 2001:db8:1:31::1 activate
  # allowas-in: the transit reflects one AS 65000 site's prefixes to
  # another, so paths arriving back here legitimately carry this node's own
  # AS. Without it the loop check drops every remote site's locator.
  neighbor 2001:db8:1:31::1 allowas-in 1
  neighbor 2001:db8:1:31::1 route-map SET_SRC in
  network fc00:0:8::/48
 exit-address-family

 # IPv4 underlay -- this node's own /32 loopback only. There is no IPv4
 # counterpart to the SRv6 locator block: tenant IPv4 (ns20/ns40) rides
 # inside SRv6 and never touches the IPv4 transit FIB.
 address-family ipv4 unicast
  neighbor 10.1.31.1 activate
  neighbor 10.1.31.1 allowas-in 1
  network 10.255.255.4/32
 exit-address-family

ip forwarding
ipv6 forwarding
