frr defaults traditional
hostname dfw-fabric
log syslog informational

interface lo
 ip address 10.255.255.2/32
 ipv6 address fc00:0:2::1/128
!
interface eth1
 description dfw-worker2-facing (primary site edge node)
 ip address 10.1.10.2/24
 ipv6 address 2001:db8:1:10::2/64
!
interface eth2
 description dfw-worker3-facing (backup site edge node)
 ip address 10.1.13.2/24
 ipv6 address 2001:db8:1:13::2/64
!

ipv6 route 2001:db8:ff01::/48 Null0
ipv6 route fc00:0:2::/48 Null0

# eth2 is a backup path, not an equal one. Both uplinks carry the same
# prefixes, but galactic-nat's shard XDP program attaches to a single
# interface (GALACTIC_NAT_UPLINK_INTERFACE, eth1 here) -- egress-shard
# traffic from another site arriving on eth2 would reach no translation
# program at all and be silently forwarded untranslated. The uSID decap hook
# does attach to both (GALACTIC_CNI_EBPF_INTERFACES="eth1,eth2" on this
# site), so ordinary tenant traffic survives a failover; the shard role does
# not, and that is why this policy exists rather than plain ECMP.
#
# Outbound: tag what this node originates toward the backup edge node, so
# that edge node can make the fabric prefer the primary's path back to here.
# Inbound: de-prefer what arrives over the backup, so this node's own egress
# also prefers eth1. Both directions are needed -- one alone leaves the
# return path or the forward path on the wrong uplink.
bgp community-list standard BACKUP_UPLINK permit 65000:900
!
route-map TO_EDGE_BACKUP permit 10
 set community 65000:900
!
route-map FROM_EDGE_BACKUP permit 10
 set local-preference 90
!
router bgp 65000
 bgp router-id 10.255.255.2
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 # Two iBGP sessions, one to each of this site's edge nodes, and nothing
 # else. A compute node is not transit-facing: it has no link to a transit
 # router and no eBGP session anywhere. Everything it learns about the rest
 # of the fabric arrives over these sessions (each edge node sets
 # next-hop-self force on its side), and everything it originates leaves
 # the site the same way. dfw is the only site with two edge nodes to
 # home to.
 neighbor 2001:db8:1:10::1 remote-as 65000
 neighbor 10.1.10.1 remote-as 65000
 neighbor 2001:db8:1:13::1 remote-as 65000
 neighbor 10.1.13.1 remote-as 65000

 address-family ipv6 unicast
  neighbor 2001:db8:1:10::1 activate
  # allowas-in: the transit reflects one AS 65000 site's prefixes to
  # another, so paths arriving back here legitimately carry this node's own
  # AS. Without it the loop check drops every remote site's locator.
  neighbor 2001:db8:1:10::1 allowas-in 1
  neighbor 2001:db8:1:13::1 activate
  neighbor 2001:db8:1:13::1 allowas-in 1
  neighbor 2001:db8:1:13::1 route-map TO_EDGE_BACKUP out
  neighbor 2001:db8:1:13::1 route-map FROM_EDGE_BACKUP in
  network 2001:db8:ff01::/48
  network fc00:0:2::/48
 exit-address-family

 # IPv4 underlay -- this node's own /32 loopback only. There is no IPv4
 # counterpart to the SRv6 locator block: tenant IPv4 (ns20/ns40) rides
 # inside SRv6 and never touches the IPv4 transit FIB.
 address-family ipv4 unicast
  neighbor 10.1.10.1 activate
  neighbor 10.1.10.1 allowas-in 1
  neighbor 10.1.13.1 activate
  neighbor 10.1.13.1 allowas-in 1
  neighbor 10.1.13.1 route-map TO_EDGE_BACKUP out
  neighbor 10.1.13.1 route-map FROM_EDGE_BACKUP in
  network 10.255.255.2/32
 exit-address-family

ip forwarding
ipv6 forwarding
