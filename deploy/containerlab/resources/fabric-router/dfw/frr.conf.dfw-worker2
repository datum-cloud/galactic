frr defaults traditional
hostname dfw-fabric-edge1
log syslog informational

interface lo
 ip address 10.255.255.6/32
 # /128. This is the address galactic-router's outbound EVPN session to the
 # route reflector sources from, auto-detected from lo via
 # GALACTIC_ROUTER_BGP_LOCAL_ADDRESS.
 ipv6 address fc00:0:a::1/128
!
interface bond0
 description tr1-facing (transit uplink) -- LACP bond of eth1 + eth3
 ip address 10.1.11.2/24
 ipv6 address 2001:db8:1:11::2/64
!
interface bond1
 description dfw-worker-facing (compute) -- LACP bond of eth2 + eth4
 ip address 10.1.10.1/24
 ipv6 address 2001:db8:1:10::1/64
!

# Aggregate covering this site's anycast ingress VIP (2001:db8:6060::1, see
# resources/galactic-gateway/*/networkrule-ns60.yaml). The VIP's own
# reachability is carried as an EVPN Type 5 path inside galactic-router's
# iBGP mesh, which the plain-IPv6-unicast transit fabric never sees at all --
# and a remote galactic-router that does learn it installs it as a plain
# (non-SRv6) kernel route keeping the VIP as the packet's literal
# destination the whole way out. Without a matching route on tr1-tr4 for that
# literal destination, a client on another site (or the off-fabric
# remote-host on tr4) has nowhere to forward it -- confirmed live as a BGP
# RIB miss on the transit before this existed.
#
# Every edge node in every site originates this identically -- DSR's anycast
# model, no primary/secondary -- so each transit router sees as many
# equal-cost paths as there are edge nodes reachable through it. Maglev's
# consistent-hash ring on the receiving node, not this route, decides which
# gateway actually answers a given flow.
ipv6 route 2001:db8:6060::/48 Null0

# This node's egress shard (resources/galactic-nat/dfw/egressshard.yaml),
# originated into the underlay: its SID's covering /64 and its two masquerade
# addresses.
#
# The masquerade addresses, because a reply from outside the fabric has to
# reach the shard that sent the request (#549). galactic-nat's
# EgressShardReconciler advertises the IPv6 address as an EVPN Type 5 path
# inside galactic-router's iBGP mesh, which the plain-IPv6-unicast transit
# never sees, and the IPv4 address is advertised by nothing at all -- a
# NAT64 reply arrives over the IPv4 underlay, which carries no EVPN. Without
# these, a reply from the off-fabric host (remote-host on tr4) meets a BGP
# RIB miss on the transit and every masqueraded flow is one-way. Each has to
# be originated by the shard's own node, since that node's datapath holds
# the flow's connection state, and each shard needs its own prefix rather
# than one aggregate covering all of them, or every site's replies would go
# to whichever originator won best-path. That now means this node: the shard
# runs here, chained behind galactic-gateway's XDP programs.
#
# The SID /64, because only the site's compute node originates the site's
# /48 (resources/fabric-router/dfw/frr.conf.dfw-worker). A remote
# sender -- or the transit -- following that aggregate would reach the
# compute node, not this one. The /64 rather than a /128 because each tenant
# writes its own Argument into the SID, so the destination differs per
# tenant.
#
# These lengths pass the transit's inbound filters unchanged
# (FILTER_PREFIX/MIN48 and FILTER_PREFIX_V4/MIN24, node_files/tr1/frr.conf),
# both of which drop short aggregates and permit anything longer.
#
# Null0 because a `network` statement needs a matching route in the RIB and
# nothing else on this node installs one. It cannot blackhole real shard
# traffic: the shard's XDP program runs at ingress, behind the gateway's, and
# claims it before any FIB lookup (internal/plumbing/ebpf/natprog). A packet
# that reaches these statics is one no shard claimed -- galactic-nat down, or
# not yet in the gateway's chain -- and dropping it is the point: forwarded
# instead, it would leave the site still carrying a tenant's private source
# address.
ipv6 route 2001:db8:ff01:2002::/64 Null0
ipv6 route 2001:db8:9966:1::/64 Null0
ip route 192.0.2.1/32 Null0

router bgp 65000
 bgp router-id 10.255.255.6
 no bgp default ipv4-unicast
 no bgp ebgp-requires-policy
 bgp log-neighbor-changes
 # eBGP to the transit. This node is one of the lab's only
 # transit-facing nodes -- compute and the route reflector have no
 # session to AS 65100 at all, and reach it through the iBGP
 # sessions below instead.
 neighbor 2001:db8:1:11::1 remote-as 65100
 neighbor 10.1.11.1 remote-as 65100
 #
 # iBGP to the workers sitting behind this node.
 neighbor 2001:db8:1:10::2 remote-as 65000
 neighbor 10.1.10.2 remote-as 65000
 !
 address-family ipv6 unicast
  neighbor 2001:db8:1:11::1 activate
  neighbor 2001:db8:1:11::1 allowas-in 1
  neighbor 2001:db8:1:10::2 activate
  # next-hop-self force: a path this node learned from the transit
  # carries the transit router's own address as next hop, which the
  # worker behind this node has no route to. "force" is load-bearing --
  # plain next-hop-self is not applied to *reflected* paths, because a
  # route reflector preserves the originator's NEXT_HOP by design
  # (RFC 4456 s.10). Without it, iad-worker learns the reflector's
  # loopback with iad-worker3's own link address as next hop, a subnet
  # it is not on, and resolves it through the Kind management
  # interface instead -- leaving the EVPN session permanently Active.
  # route-reflector-client: iBGP split horizon would otherwise stop
  # this node passing one client's prefixes to another (iad has two).
  neighbor 2001:db8:1:10::2 next-hop-self force
  neighbor 2001:db8:1:10::2 route-reflector-client
  # /128, not the site /48 -- a per-node peering loopback is the only
  # thing meant to cross the transit as a host route.
  network fc00:0:a::1/128
  # Anycast ingress VIP aggregate -- see this file's own comment above.
  network 2001:db8:6060::/48
  # This node's egress shard's SID /64 and IPv6 masquerade address -- see
  # this file's own comment above.
  network 2001:db8:ff01:2002::/64
  network 2001:db8:9966:1::/64
 exit-address-family
 !
 # IPv4 underlay -- this node's /32 loopback, plus its egress shard's
 # NAT64 masquerade address. There is no IPv4 counterpart to the SRv6
 # locator block, and the ingress VIP aggregate stays IPv6-only: this lab's
 # NetworkRule VIPs are IPv6, matching the edge datapath's own scope (see
 # edgedsr.c).
 address-family ipv4 unicast
  neighbor 10.1.11.1 activate
  neighbor 10.1.11.1 allowas-in 1
  neighbor 10.1.10.2 activate
  neighbor 10.1.10.2 next-hop-self force
  neighbor 10.1.10.2 route-reflector-client
  network 10.255.255.6/32
  # This node's egress shard's IPv4 (NAT64) masquerade address. A NAT64
  # reply arrives from an IPv4-only destination, so unlike tenant IPv4 it
  # does not ride inside SRv6 and does need a route in the transit FIB.
  network 192.0.2.1/32
 exit-address-family
!

ip forwarding
ipv6 forwarding
