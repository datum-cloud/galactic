@startuml cni-chain
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title galactic-veth CNI chain — Component Diagram (six binaries, one shared image)

Container_Boundary(cnichain, "galactic-cni image (ghcr.io/datum-cloud/galactic-cni)") {
    Component(installer, "galactic-cni", "Go binary (installer)", "DaemonSet init/run: stages every binary below onto the host, writes conflist + kubeconfig, manages the uSID eBPF datapath lifecycle, serves gRPC health. Never itself a CNI plugin.")
    Component(masterveth, "galactic-veth", "Go binary, CNI master plugin", "Container attach: VRF + veth pair, NAD annotation, host-device delegation")
    Component(mastertap, "galactic-tap", "Go binary, CNI master plugin", "VM attach: VRF + tap device; no guest netns, no host-device delegation")
    Component(route, "galactic-route", "Go binary, optional chain stage", "Installs VRF-table termination routes; no Kubernetes dependency")
    Component(bgp, "galactic-bgp", "Go binary, chain stage", "Learns interface/addresses from prevResult only; writes BGPVRFInstance/BGPAdvertisement; registers eBPF uSID map entries")
    Component(ipam, "galactic-ipam", "Go binary, delegated CNI IPAM", "IPv4/IPv6 pool + static allocators; on-disk marker files; no Kubernetes dependency")
    Component(vmtap, "vmtap-cni", "Go binary", "Patches Cilium's own chain conflist to add a tap stage for VM workloads — unrelated to the veth/tap/ipam/bgp/route chain")
}

Container_Ext(usidbpf, "SRv6 uSID datapath", "TC-BPF (cilium/ebpf)")
Container_Ext(crds, "BGP CRDs", "go.datum.net/network API")
System_Ext(cilium, "Cilium CNI", "Primary CNI on the node; vmtap-cni patches its chain conflist")
System_Ext(k8sapi, "Kubernetes API Server")

Rel(installer, masterveth, "Stages onto host", "/opt/cni/bin")
Rel(installer, mastertap, "Stages onto host")
Rel(installer, ipam, "Stages onto host")
Rel(installer, route, "Stages onto host")
Rel(installer, bgp, "Stages onto host")
Rel(installer, vmtap, "Stages onto host")
Rel(installer, usidbpf, "Loads/attaches program; serves metrics", "run subcommand")
Rel(installer, k8sapi, "Node identity check; kubeconfig refresh", "client-go")

Rel_R(masterveth, ipam, "Delegates IPAM", "CNI IPAM protocol")
Rel_R(mastertap, ipam, "Delegates IPAM", "CNI IPAM protocol")
Rel_D(masterveth, route, "Chained next (conflist order)\nprevResult passthrough")
Rel_D(mastertap, route, "Chained next (conflist order)\nprevResult passthrough")
Rel_R(route, bgp, "Chained next (conflist order)\n[optional — bgp chains directly\nafter master if no terminations]")

Rel(bgp, crds, "Writes BGPVRFInstance + BGPAdvertisement", "bare controller-runtime client")
Rel(bgp, usidbpf, "Registers locator/function/vrf_table entries", "cilium/ebpf")
Rel(bgp, k8sapi, "Node lookup; CRD CRUD", "client-go")
Rel(masterveth, k8sapi, "Node lookup; NAD annotation patch", "client-go")
Rel(vmtap, cilium, "Patches chain conflist to add tap stage", "file write")

@enduml
