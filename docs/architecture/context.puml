@startuml context
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title Galactic system context
Person(operator, "Platform operator", "Deploys and operates routing and tenant networking")
Person(tenant, "Tenant", "Runs VPC-attached workloads")
System_Ext(nso, "NSO cell manager", "Reconciles VPCs, attachments and NetworkAttachmentDefinitions")
System_Ext(ipam, "Platform IPAM and federation hub", "Central allocation and distribution of network identity")
System_Ext(k8s, "Kubernetes API", "Desired resources and observed status")
System_Ext(workloads, "Compute and providers", "Pods, VMs and authorized Edge services")
System_Ext(internet, "External networks", "Ingress clients and egress destinations")
System(galactic, "Galactic", "Fabric routing, SRv6 VPC forwarding, BGP, ingress and egress datapaths")
Rel(operator, galactic, "Deploys and configures")
Rel(tenant, workloads, "Runs workloads")
Rel(nso, k8s, "Writes VPC and attachment intent")
Rel(galactic, k8s, "Reads intent and reports programming")
Rel(galactic, ipam, "Allocates and publishes fabric identity", "galactic-controller fabric role")
Rel(workloads, galactic, "Attaches and exchanges traffic", "CNI / Edge API")
Rel(internet, galactic, "Connects to ingress VIPs", "IPv4 / IPv6 TCP and UDP")
Rel(galactic, internet, "Translates tenant egress", "NAT66 / NAT64")
@enduml
