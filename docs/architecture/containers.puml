@startuml containers
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Galactic deployment groups
System_Ext(k8s, "Kubernetes API")
System_Ext(nso, "NSO cell manager", "Owns VPC and attachment lifecycle")
System_Boundary(galactic, "Galactic") {
    Container(cni, "galactic-cni and CNI chain", "Go / TC-BPF", "Installer, workload attachment, uSID datapath and map repair; nodes with galactic=router")
    Container(router, "galactic-router", "Go / embedded GoBGP", "Tenant EVPN, policy and backend bindings; galactic=router or control for reflectors")
    Container(gateway, "galactic-gateway", "Go / XDP", "Anycast L4 ingress; node=edge and gateway=enabled")
    Container(nat, "galactic-nat", "Go / XDP", "Stateful NAT66/NAT64 shards; node=edge and nat=enabled")
    Container(edge, "galactic-edge", "Go / TC-BPF", "Provider attachment programming and forwarding gates; node=edge and edge=enabled")
    Container(vrf, "galactic-vrf", "Go / TC-BPF", "Ingress sidecar VPC forwarding; placed by its owning workload")
    Container(cell, "galactic-controller cell", "Go", "Policy admission, pod injection, programming status; optional Edge core")
    Container(identity, "galactic-controller fabric", "Go", "Central network identity allocation; separate hub/IPAM credentials")
    Container(frr, "fabric-router", "FRR / fabric-config-agent", "Underlay sessions and per-node config activation; fabric=router or control")
    Container(fabricctl, "fabric-router-controller", "Go", "Compile revisions; optional rollout and topology generation")
    Container(api, "fabric-api", "Go / mTLS gRPC", "Optional node diagnostics, cell gateway, certificate sync and janitor")
}
Rel(nso, k8s, "Writes VPCs and attachments")
Rel(cni, k8s, "Writes attachment BGP state")
Rel(router, k8s, "Reconciles routing and bindings")
Rel(gateway, k8s, "Reads services; writes BGP advertisements")
Rel(nat, k8s, "Reconciles shards; writes BGP advertisements")
Rel(edge, k8s, "Programs attachments; reports gates and release")
Rel(cell, k8s, "Admits, reconciles and reports")
Rel(identity, k8s, "Publishes identities on the hub")
Rel(fabricctl, k8s, "Writes revisions, releases and generated peers")
Rel(frr, k8s, "Reads node configuration and activation intent")
Rel(api, frr, "Reads routing state", "vty / BMP")
Rel(router, cni, "Programs shared pinned maps", "BPF")
Rel(cni, nat, "Sends tenant egress", "SRv6")
Rel(gateway, cni, "Sends ingress to backends", "SRv6")
Rel(vrf, cni, "Registers ingress and return-path state", "Pinned BPF maps")
Rel(router, frr, "Uses underlay IP reachability for EVPN sessions")
@enduml
