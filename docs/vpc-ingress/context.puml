@startuml context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title VPC HTTP Ingress — System Context (Envoy Gateway to a VPC-hosted workload)

Person_Ext(client, "External Client", "Sends an HTTP request to a Gateway VIP")
Person(tenant, "Tenant / Developer", "Authors HTTPProxy/HTTPRoute rules that select a VPC-hosted backend")
Person(operator, "Platform Operator", "Deploys the Envoy Gateway fleet and Galactic's node DaemonSets")

System(ingress, "VPC HTTP Ingress path", "Shared Envoy Gateway fleet (envoy + vpc-vrf-sidecar containers) plus the Galactic CNI/router components that give it a route into a tenant VPC")

System_Ext(k8s, "Kubernetes API Server", "Gateway API resources (Gateway/HTTPRoute) and this repo's BGP CRDs (BGPRouter, BGPAdvertisement, BGPVRFInstance)")
System_Ext(nso, "NSO Envoy Gateway Extension Server", "network-services-operator — resolves HTTPProxy backends to VPC Pods and patches Envoy's generated xDS config; a separate repo, not covered by this doc set")
System_Ext(vpcop, "VPC Operator", "Owns VPC/VPCAttachment CRD lifecycle; pre-populates the identifiers galactic-cni acts on")
System_Ext(fabric, "Underlay Fabric / iBGP Mesh", "fabric-router (FRR eBGP underlay) plus galactic-router's embedded GoBGP; distributes EVPN paths and the sidecar's own gateway-address advertisement")
System_Ext(workload, "Tenant VPC Workload", "The Pod (or tap-attached VM) the request is ultimately routed to")

Rel(client, ingress, "HTTP request to a Gateway VIP:port", "IPv6")
Rel(tenant, ingress, "Authors HTTPProxy rules", "Kubernetes API")
Rel(operator, ingress, "Deploys / configures", "kubectl apply -k, Kustomize")

Rel(ingress, k8s, "Watches/writes Gateway API and BGP CRDs", "controller-runtime, bare client")
Rel(ingress, nso, "Envoy's per-cluster xDS config (SO_BINDTODEVICE, backend clusters) is generated and patched by")
Rel(vpcop, ingress, "Pre-populates VPC/VPCAttachment identifiers", "CNI config / NAD annotation")
Rel(ingress, fabric, "Distributes EVPN paths and the gateway's own return-path advertisement over", "iBGP")
Rel(ingress, workload, "Delivers the decapsulated request to, and carries its reply back from", "SRv6 uSID, TC-BPF decap")

@enduml
