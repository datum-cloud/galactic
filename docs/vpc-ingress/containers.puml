@startuml containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title VPC HTTP Ingress — Container Diagram

Person_Ext(client, "External Client")
Person(tenant, "Tenant / Developer", "Authors HTTPProxy/HTTPRoute rules")

System_Boundary(ingress, "VPC HTTP Ingress path") {
    Container_Boundary(envoypod, "Envoy Gateway Pod (one per node; envoyDaemonSet)") {
        Container(envoy, "envoy", "Envoy proxy", "Terminates the client HTTP connection; its upstream socket to the VPC backend is SO_BINDTODEVICE-bound to the sidecar's VRF device by the NSO extension server — stays on the cluster overlay, never gets a VPCAttachment of its own")
        Container(vrfsidecar, "vpc-vrf-sidecar", "Go, controller-runtime (cmd/galactic-vrf)", "Watches EndpointSlice; creates a per-tenant-VPC Linux VRF + SRv6 egress route in its own pod netns; publishes a BGPAdvertisement for its own return-path gateway address")
    }

    Container(cnichain, "galactic CNI chain", "Go binaries: galactic-veth/galactic-tap, galactic-ipam, galactic-bgp, galactic-route", "Attaches a tenant Pod/VM to its VPC on CNI ADD: VRF, veth/tap, SRv6 registration; writes BGPVRFInstance + BGPAdvertisement + one EndpointSlice per pod")
    Container(cniinstaller, "galactic-cni installer daemon", "Go (internal/installer)", "Node agent: loads/attaches the shared uSID datapath; also reconciles the host-side half of the sidecar's return path (locator_table/function_table/vrf_table + neighbor) so a decapsulated reply can cross back into the sidecar's pod netns")
    Container(usidbpf, "TC-BPF uSID datapath", "eBPF (cilium/ebpf), clsact — ingress hook only", "usid_ingress on the shared host uplink(s): outer-header decap + FIB lookup + redirect. usid_egress on each tenant/sidecar VRF's host-side veth or tap ingress hook: SRv6 uSID encapsulation on the way out. Galactic never attaches to a tc egress hook")

    Container(router, "galactic-router", "Go, controller-runtime", "Reconciles BGPRouter/BGPPeer/BGPAdvertisement/BGPVRFInstance; drives an embedded GoBGP server; runs orphaned-CRD GC")
    Container(gobgp, "Embedded GoBGP", "osrg/gobgp v4", "EVPN path origination and import for this node")
}

Container_Ext(crds, "BGP CRDs", "go.datum.net/network API", "BGPRouter, BGPPeer, BGPAdvertisement, BGPVRFInstance — configure the path; never touched by a packet")
Container_Ext(fabricrouter, "fabric-router", "FRR DaemonSet", "eBGP underlay reachability between nodes")
System_Ext(k8sapi, "Kubernetes API Server")
System_Ext(nso, "NSO Envoy Gateway Extension Server", "Patches envoy's generated config; not in this repo")

Rel(client, envoy, "HTTP request to the Gateway VIP", "IPv6")
Rel(nso, envoy, "Generates/patches upstream cluster config (SO_BINDTODEVICE, backend addresses from EndpointSlice)")
Rel(envoy, vrfsidecar, "Shares one pod netns; no direct RPC — kernel-mediated via the shared VRF device")
Rel(tenant, k8sapi, "Authors HTTPProxy rules (resolved by NSO, not this repo)")

Rel(vrfsidecar, k8sapi, "Watches EndpointSlice (backend discovery); reads BGPRouter; writes its own BGPAdvertisement", "controller-runtime manager")
Rel(vrfsidecar, usidbpf, "Installs egress_route_table entries; attaches usid_egress to its own VRF's host-side veth", "cilium/ebpf, in-pod-netns")

Rel(cnichain, k8sapi, "Reads pre-populated VPC/VPCAttachment identifiers (CNI config); writes BGPVRFInstance, BGPAdvertisement, EndpointSlice", "bare controller-runtime client")
Rel(cnichain, usidbpf, "Registers locator/function/vrf_table entries; attaches usid_egress to the tenant Pod's host-side veth/tap", "cilium/ebpf")

Rel(cniinstaller, usidbpf, "Loads and pins usid_ingress/usid_egress; attaches usid_ingress to the host's uplink(s)", "cilium/ebpf")
Rel(cniinstaller, k8sapi, "Reads BGPAdvertisement/BGPRouter to seed the sidecar's return-path host state", "client-go")

Rel(router, crds, "Watches/updates status", "controller-runtime manager")
Rel(router, gobgp, "Applies DesiredRouter (peers, VRFs, EVPN paths)", "in-process")
Rel(gobgp, fabricrouter, "Peers over eBGP underlay", "eBGP")

Rel(usidbpf, fabricrouter, "SRv6-encapsulated packets ride the underlay this provides reachability for", "IPv6-in-IPv6, no SRH")

@enduml
