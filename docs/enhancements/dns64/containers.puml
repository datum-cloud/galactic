@startuml containers
!include <C4/C4_Container>

LAYOUT_LANDSCAPE()
skinparam defaultFontName SansSerif
skinparam shadowing false
skinparam backgroundColor white
UpdateElementStyle("container", $bgColor="#E8F2FF", $fontColor="#172B4D", $borderColor="#2C5D94")
UpdateElementStyle("external_system", $bgColor="#F2F3F5", $fontColor="#172B4D", $borderColor="#596579")
UpdateElementStyle("external_container", $bgColor="#F2F3F5", $fontColor="#172B4D", $borderColor="#596579")
UpdateBoundaryStyle("system", $bgColor="#FAFBFC", $fontColor="#172B4D", $borderColor="#596579")

title Shared DNS64: proposed architecture

System_Ext(compute, "Compute", "IPv6-only customer instances")
System_Ext(galactic, "Galactic networking", "Network attachment and SRv6 routing")

System_Boundary(dns, "Datum DNS service: shared regional fleet (proposed)") {
    Container(ingress, "Resolver service", "IPv6 VIP and health-aware load balancing", "Authorizes endpoint access, limits traffic,\nand selects ready replicas")
    Container(resolver, "Resolver shard", "PowerDNS Recursor replicas", "Performs recursion, DNSSEC validation,\ncaching, and DNS64 synthesis")
    Container(controller, "DNS service controller", "Go; production integration required", "Publishes resolver configuration, validates\nthe shared prefix, and verifies readiness")
}

Container_Ext(networkapi, "Network API", "Kubernetes API", "Publishes EgressShard status,\nincluding the shared NAT64 prefix")
Container_Ext(nat, "NAT64 gateway", "galactic-nat", "Translates connections to IPv4;\nkeeps gateway-local session state")
System_Ext(upstream, "DNS upstreams", "Public recursive resolution")
System_Ext(destination, "IPv4 service", "Destination reachable from\nthe NAT64 gateway")

Rel_R(compute, galactic, "DNS and application traffic", "IPv6")
Rel_R(galactic, ingress, "Resolver queries", "DNS over UDP/TCP")
Rel_R(ingress, resolver, "Selects ready replica", "DNS")
Rel_R(resolver, upstream, "Public resolution", "DNS")
Rel_D(galactic, nat, "Application traffic", "SRv6")
Rel_L(nat, destination, "Translates connections", "IPv4 TCP/UDP")
Rel_D(controller, ingress, "Ready configuration", "")
Rel_L(networkapi, controller, "Prefix status", "")

Lay_R(compute, galactic)
Lay_R(galactic, ingress)
Lay_R(ingress, resolver)
Lay_R(resolver, upstream)
Lay_D(galactic, nat)
Lay_L(nat, destination)
Lay_L(networkapi, controller)

footer DNS answers do not select a NAT64 shard. Endpoint delivery requires integration.
@enduml
